# PostgreSQL connection string used by Prisma (apps/api)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nova?schema=public"

# API server
API_HOST="127.0.0.1"
API_PORT="3001"

# Next.js web application
WEB_PORT="3000"

# Public API base URL consumed by the web app (future use)
NEXT_PUBLIC_API_URL="http://127.0.0.1:3001"

# Transactional email. Use a Resend API key and verified sender outside tests.
RESEND_API_KEY=""
RESEND_SENDER="NOVA <noreply@example.com>"
PUBLIC_APP_ORIGIN="http://localhost:3000"
# Generate with: openssl rand -base64 32
EMAIL_ENCRYPTION_KEY=""

# One-time Platform Administrator bootstrap; keep secret and remove after bootstrap.
PLATFORM_BOOTSTRAP_TOKEN=""
PLATFORM_BOOTSTRAP_EMAIL=""
PLATFORM_BOOTSTRAP_PASSWORD=""
