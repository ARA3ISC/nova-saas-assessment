generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentityStatus {
  ACTIVE
  DISABLED
}

enum OrganizationAccessStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum CommercialStatus {
  DEMO
  PILOT
  ACTIVE
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum BusinessScopeStatus {
  ACTIVE
  INACTIVE
}

enum BusinessScopeType {
  RESTAURANT
  PROPERTY_DEVELOPMENT
  CONSTRUCTION
  EVENT
}

enum OrganizationProfile {
  Administrator
  User
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationKind {
  INITIAL_OWNER
  COLLABORATOR
}

enum TransactionalEmailTemplate {
  INITIAL_OWNER_INVITATION_V1
  COLLABORATOR_INVITATION_V1
  PASSWORD_RESET_V1
}

enum OutboxMessageStatus {
  PENDING
  DELIVERED
  EXPIRED
}

enum OwnershipTransferStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

model Identity {
  id              String         @id @default(uuid()) @db.Uuid
  email           String
  normalizedEmail String         @unique
  status          IdentityStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordCredential  PasswordCredential?
  authSessions        AuthSession[]
  passwordResetTokens PasswordResetToken[]
  membership          Membership?
  platformPrincipal   PlatformPrincipal?

  @@index([email])
}

model PasswordCredential {
  id                 String  @id @default(uuid()) @db.Uuid
  identityId         String  @unique @db.Uuid
  passwordHash       String
  mustChangePassword Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id                    String    @id @default(uuid()) @db.Uuid
  identityId            String    @db.Uuid
  tokenHash             String    @unique
  createdAt             DateTime  @default(now())
  lastSeenAt            DateTime  @default(now())
  expiresAt             DateTime
  absoluteExpiresAt     DateTime
  recentAuthenticatedAt DateTime?
  revokedAt             DateTime?

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id            String    @id @default(uuid()) @db.Uuid
  identityId    String    @db.Uuid
  tokenHash     String    @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([expiresAt])
}

model AuthenticationThrottle {
  id                String    @id @default(uuid()) @db.Uuid
  normalizedAccount String
  sourceBucket      String
  failureCount      Int       @default(0)
  firstFailedAt     DateTime?
  lastFailedAt      DateTime?
  lockedUntil       DateTime?
  updatedAt         DateTime  @updatedAt

  @@unique([normalizedAccount, sourceBucket])
  @@index([lockedUntil])
}

model PlatformPrincipal {
  id         String @id @default(uuid()) @db.Uuid
  identityId String @unique @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
}

model Organization {
  id               String                   @id @default(uuid()) @db.Uuid
  name             String
  accessStatus     OrganizationAccessStatus @default(PROVISIONING)
  commercialStatus CommercialStatus         @default(DEMO)
  version          Int                      @default(1)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  disabledAt DateTime?

  companies                  Company[]
  memberships                Membership[]
  ownership                  OrganizationOwnership?
  businessScopes             BusinessScope[]
  invitations                Invitation[]
  outboxMessages             OutboxMessage[]
  ownershipTransferProposals OwnershipTransferProposal[]
  capabilityGrants           CapabilityGrant[]
  auditEvidence              AuditEvidence[]
  permissionPresetVersions   PermissionPresetVersion[]

  @@index([accessStatus])
  @@index([commercialStatus])
}

model OwnershipTransferProposal {
  id                    String                  @id @default(uuid()) @db.Uuid
  organizationId        String                  @db.Uuid
  proposerMembershipId  String                  @db.Uuid
  successorMembershipId String                  @db.Uuid
  status                OwnershipTransferStatus @default(PENDING)
  expiresAt             DateTime
  acceptedAt            DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposer              Membership              @relation("OwnershipTransferProposer", fields: [organizationId, proposerMembershipId], references: [organizationId, id], onDelete: Restrict)
  successor             Membership              @relation("OwnershipTransferSuccessor", fields: [organizationId, successorMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, status])
}

model OutboxMessage {
  id                String                     @id @default(uuid()) @db.Uuid
  organizationId    String?                    @db.Uuid
  recipient         String
  template          TransactionalEmailTemplate
  deliveryKey       String                     @unique
  encryptedEnvelope String
  status            OutboxMessageStatus        @default(PENDING)
  attemptCount      Int                        @default(0)
  providerMessageId String?
  lastFailureCode   String?
  deliveredAt       DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([status, createdAt])
}

model Membership {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  identityId     String              @unique @db.Uuid
  profile        OrganizationProfile
  status         MembershipStatus    @default(ACTIVE)

  accessEpoch            Int     @default(0)
  version                Int     @default(1)
  organizationWideAccess Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  suspendedAt DateTime?
  removedAt   DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  ownership                   OrganizationOwnership?
  proposedOwnershipTransfers  OwnershipTransferProposal[] @relation("OwnershipTransferProposer")
  successorOwnershipTransfers OwnershipTransferProposal[] @relation("OwnershipTransferSuccessor")
  capabilityGrants            CapabilityGrant[]
  companyGrants               CompanyGrant[]
  businessScopeGrants         BusinessScopeGrant[]

  @@unique([organizationId, id])
  @@unique([organizationId, identityId])
  @@index([organizationId, status])
  @@index([organizationId, profile])
}

model OrganizationOwnership {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @db.Uuid
  membershipId   String @unique @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  membership Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, membershipId])
}

model Invitation {
  id                     String              @id @default(uuid()) @db.Uuid
  organizationId         String              @db.Uuid
  email                  String
  normalizedEmail        String
  tokenHash              String              @unique
  kind                   InvitationKind
  targetProfile          OrganizationProfile
  capabilities           Json                @default("[]")
  companyIds             Json                @default("[]")
  businessScopeIds       Json                @default("[]")
  organizationWideAccess Boolean             @default(false)
  expiresAt              DateTime
  consumedAt             DateTime?
  revokedAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, normalizedEmail, kind])
  @@index([organizationId, normalizedEmail])
  @@index([organizationId, expiresAt])
}

model CapabilityGrant {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  membershipId   String       @db.Uuid
  capability     String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     Membership   @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, membershipId, capability])
  @@index([organizationId, membershipId])
}

model AuditEvidence {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorId        String       @db.Uuid
  action         String
  reason         String
  subjectType    String
  subjectId      String       @db.Uuid
  correlationId  String       @default(uuid()) @db.Uuid
  before         Json
  after          Json
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([correlationId])
}

model CapabilityDefinition {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  label        String
  scopeType    String
  active       Boolean  @default(true)
  platformOnly Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PermissionPresetVersion {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  key            String
  label          String
  version        Int
  capabilities   Json     @default("[]")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key, version])
  @@index([organizationId, active])
}

model CompanyGrant {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  membershipId   String     @db.Uuid
  companyId      String     @db.Uuid
  createdAt      DateTime   @default(now())
  membership     Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  company        Company    @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, membershipId, companyId])
}

model BusinessScopeGrant {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @db.Uuid
  membershipId    String        @db.Uuid
  businessScopeId String        @db.Uuid
  createdAt       DateTime      @default(now())
  membership      Membership    @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  businessScope   BusinessScope @relation(fields: [organizationId, businessScopeId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, membershipId, businessScopeId])
}

model Company {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  name           String
  status         CompanyStatus @default(ACTIVE)
  version        Int           @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  businessScopes BusinessScope[]
  grants         CompanyGrant[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model BusinessScope {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  companyId      String @db.Uuid

  type                         BusinessScopeType
  name                         String
  normalizedName               String
  externalIdentifier           String?
  normalizedExternalIdentifier String?
  location                     String?
  responsiblePerson            String?
  sectorCounterpart            String?
  status                       BusinessScopeStatus @default(ACTIVE)
  version                      Int                 @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  company Company              @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)
  grants  BusinessScopeGrant[]

  @@unique([organizationId, id])
  @@unique([organizationId, companyId, type, normalizedName, normalizedExternalIdentifier])
  @@index([organizationId, companyId, status])
  @@index([organizationId, normalizedName])
}
